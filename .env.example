# Copy this file to .env and fill in the values from your Supabase project:
#   Supabase dashboard -> Project Settings -> Data API / API Keys
#
# Both values are safe to expose in a browser bundle. The anon key only grants
# the access allowed by the Row Level Security policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
